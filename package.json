{
  "name": "swan-vault-recovery-assistant",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && pnpm exec prettier --write dist",
    "ci:gitdiff": "git diff -b --ignore-blank-lines --exit-code",
    "clean": "rm -rf dist && rm -rf src-tauri/target",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build && tsx scripts/rename-artifacts.ts",
    "lint": "eslint .",
    "test": "pnpm test:watch run",
    "test:scenario": "pnpm test:scenario:watch run",
    "test:scenario:watch": "vitest --project scenario",
    "test:unit": "pnpm test:unit:watch run",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "tsx scripts/fetch-hwi.ts",
    "prepare": "husky",
    "simnet": "tsx test/scripts/simulate-network.ts",
    "simulate-network": "pnpm simnet"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2.7.1",
    "@types/node": "^22.17.0",
    "@types/selenium-webdriver": "^4.1.28",
    "@types/semver": "^7.7.1",
    "autoprefixer": "^10.4.21",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoin-core": "^4.2.0",
    "bitcoinjs-lib": "^6.1.7",
    "clipboardy": "^4.0.0",
    "daisyui": "^4.12.24",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "nano-staged": "^0.8.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "progress-stream": "^2.0.0",
    "pure-rand": "^6.1.0",
    "selenium-webdriver": "^4.34.0",
    "semver": "^7.7.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.4.3",
    "tiny-secp256k1": "^2.2.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "unzip-stream": "^0.3.4",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "nano-staged": {
    "*.{js,json,yml,yaml,html,md,css,ts}": "pnpm exec prettier --write",
    "*.rs": "rustfmt"
  }
}
