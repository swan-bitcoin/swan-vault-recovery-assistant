{
  "name": "tempura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && pnpm exec prettier --write dist",
    "ci:gitdiff": "git diff -b --ignore-blank-lines --exit-code",
    "clean": "rm -rf dist && rm -rf src-tauri/target",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "test": "pnpm test:watch run",
    "test:scenario": "pnpm test:scenario:watch run",
    "test:scenario:watch": "vitest --project scenario",
    "test:unit": "pnpm test:unit:watch run",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest",
    "postinstall": "tsx scripts/fetch-hwi.ts",
    "prepare": "husky",
    "simnet": "tsx test/scripts/simulate-network.ts",
    "simulate-network": "pnpm simnet"
  },
  "dependencies": {
    "@tauri-apps/api": ">=2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tauri-apps/cli": ">=2.0.0",
    "@types/node": "^22.7.4",
    "@types/selenium-webdriver": "^4.1.27",
    "autoprefixer": "^10.4.20",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoin-core": "^4.2.0",
    "bitcoinjs-lib": "^6.1.3",
    "clipboardy": "^4.0.0",
    "daisyui": "^4.12.13",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "nano-staged": "^0.8.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "progress-stream": "^2.0.0",
    "pure-rand": "^6.1.0",
    "selenium-webdriver": "^4.25.0",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.4.3",
    "tiny-secp256k1": "^2.2.3",
    "tsx": "^4.19.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.11.0",
    "unzip-stream": "^0.3.4",
    "vite": "^5.3.1",
    "vitest": "^2.1.2"
  },
  "nano-staged": {
    "*.{js,json,yml,yaml,html,md,css,ts}": "pnpm exec prettier --write",
    "*.rs": "rustfmt"
  }
}
