# Supply-chain hardening (PSEC-4882)
#
# ignore-scripts: block lifecycle scripts (preinstall/install/postinstall)
#   for all packages AND the root project. The HWI binary fetch is now an
#   explicit `pnpm run fetch:hwi` step rather than running implicitly on
#   `pnpm install`. Husky hooks must be installed manually after clone
#   (`pnpm exec husky`) — see README.
#
# frozen-lockfile: require pnpm-lock.yaml to match package.json. CI already
#   passes `--frozen-lockfile` explicitly; this enforces the same in local
#   dev so an out-of-band edit can't drift the lockfile.
#
# engine-strict: refuse to install when the host's Node/pnpm version is
#   outside the `engines` range in package.json.
ignore-scripts=true
frozen-lockfile=true
engine-strict=true
